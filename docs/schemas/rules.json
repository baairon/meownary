{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meownary rules v1",
  "$ref": "#/$defs/rules",
  "$defs": {
    "encoding": {
      "enum": [
        "ascii",
        "utf8",
        "utf16le",
        "utf16be",
        "windows1252"
      ]
    },
    "boundary": {
      "enum": [
        "substring",
        "word",
        "identifier"
      ]
    },
    "pattern": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "hex"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            },
            "encoding": {
              "$ref": "#/$defs/encoding"
            },
            "ignore_ascii_case": {
              "type": "boolean"
            },
            "boundary": {
              "$ref": "#/$defs/boundary"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "publisher",
            "product",
            "toolchain",
            "third_party",
            "credits",
            "build_paths"
          ]
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "encodings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/encoding"
          }
        },
        "boundary": {
          "$ref": "#/$defs/boundary"
        },
        "ignore_ascii_case": {
          "type": "boolean"
        },
        "replacement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pad": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_matches": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "scope",
        "names"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  }
}
